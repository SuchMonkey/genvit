# llama-server router configuration (conffile).
# Written for llama-cpp b9888; full option list:
#   llama-server --help
#   https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md
#
# This file is read by systemd (EnvironmentFile=) and applies to the router
# AND, via inheritance, to every model instance it loads. Per-model overrides
# live in /etc/llama-server/models.ini (preset args win over these env vars).

# ---- network ---------------------------------------------------------------
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8033
# LLAMA_ARG_REUSE_PORT=1
# LLAMA_ARG_SSL_CERT_FILE=/etc/llama-server/cert.pem
# LLAMA_ARG_SSL_KEY_FILE=/etc/llama-server/key.pem

# ---- auth (fail-closed: no key file means every request gets 401) ----------
LLAMA_ARG_API_KEY_FILE=/etc/llama-server/api-keys

# ---- model management ------------------------------------------------------
# llama.cpp's own HF download store (the --models-dir alternative is unused;
# models are installed with `llama-server-model install <repo>:<quant>`).
LLAMA_CACHE=/var/lib/llama-server/cache
LLAMA_ARG_MODELS_PRESET=/etc/llama-server/models.ini
LLAMA_ARG_MODELS_MAX=4
# LLAMA_ARG_MODELS_AUTOLOAD=0

# ---- inference defaults inherited by every model ---------------------------
# Safe default context; boost per-model in models.ini (e.g. 65536).
LLAMA_ARG_CTX_SIZE=8192
# LLAMA_ARG_N_GPU_LAYERS=auto
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_TYPE_K=q4_0
LLAMA_ARG_CACHE_TYPE_V=q4_0
LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_K=q4_0
LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_V=q4_0
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CACHE_RAM=16384
LLAMA_ARG_BATCH=2048
LLAMA_ARG_UBATCH=512
LLAMA_ARG_N_PARALLEL=1
# LLAMA_ARG_FIT=on
# LLAMA_ARG_CACHE_PROMPT=1
# LLAMA_ARG_CACHE_REUSE=0

# ---- endpoints / UI --------------------------------------------------------
# LLAMA_ARG_ENDPOINT_METRICS=1
# LLAMA_ARG_ENDPOINT_PROPS=1
# LLAMA_ARG_UI=1
# LLAMA_ARG_JINJA=1
# LLAMA_ARG_EMBEDDINGS=1
# LLAMA_ARG_RERANKING=1

# ---- logging ---------------------------------------------------------------
# LLAMA_ARG_LOG_VERBOSITY=3
# LLAMA_ARG_LOG_TIMESTAMPS=1
# LLAMA_ARG_LOG_FILE=/var/lib/llama-server/server.log

# ---- misc ------------------------------------------------------------------
# LLAMA_ARG_TIMEOUT=3600
# LLAMA_ARG_THREADS_HTTP=-1
# LLAMA_ARG_OFFLINE=1
